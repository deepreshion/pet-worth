              "name": "Календарь и прокрутка",
              "width": "fill_container",
              "height": 440,
              "layout": "vertical",
              "gap": 16,
              "children": [
                {
                  "type": "text",
                  "id": "kek6g",
                  "name": "Заголовок раздела",
                  "fill": "$pw-ink",
                  "content": "Календарь и прокрутка",
                  "fontFamily": "$pw-font",
